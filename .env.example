# Copy to `.env` and adjust. `scripts/db-local.sh start` creates a matching
# local cluster on port 55432 with trust authentication, so the defaults below
# work out of the box on a fresh machine.

DATABASE_URL="postgresql://postgres@127.0.0.1:55432/tradeflow?schema=public"

# Prisma's `migrate dev` needs a second, empty database to detect drift.
# It is never used at runtime.
SHADOW_DATABASE_URL="postgresql://postgres@127.0.0.1:55432/tradeflow_shadow?schema=public"

# Signing key for session tokens. Must be at least 32 characters.
# Generate: openssl rand -base64 48
JWT_SECRET="dev-only-secret-do-not-use-in-production-000000000000"

# Token lifetime.
JWT_EXPIRES_IN="8h"

PORT=3001
NODE_ENV="development"

# Public origin of the web app, used to build the customer's accept link.
PUBLIC_WEB_ORIGIN="http://localhost:3000"

# ---- Optional: AI-assisted quoting -------------------------------------------
# The drafting feature ships with a deterministic provider that needs no key, so
# the demo and CI work offline. Set AI_PROVIDER=llm plus a key to use a hosted
# model instead. See apps/api/src/ai/.
AI_PROVIDER="heuristic"
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# The e2e suite resets and reseeds its database, so it points somewhere
# disposable. Leave unset to run against DATABASE_URL (and lose its data).
TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:55432/tradeflow_test?schema=public"
